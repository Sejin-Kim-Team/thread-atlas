{
  "manifest_version": 3,
  "name": "ThreadAtlas",
  "version": "0.1.0",
  "permissions": ["activeTab", "clipboardWrite", "commands", "contextMenus", "identity", "scripting", "sidePanel", "storage", "tabs"],
  "host_permissions": ["*://news.ycombinator.com/*", "<all_urls>"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-semantic.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://news.ycombinator.com/*"],
      "js": ["content-hn.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles/highlight.css", "page-audio-bridge.js", "audio-input-worklet.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "ThreadAtlas",
    "default_popup": "popup.html"
  },
  "commands": {
    "capture-snapshot": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Capture Semantic Snapshot"
    },
    "toggle-selection": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Toggle Semantic Selection"
    }
  }
}
